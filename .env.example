# Michelle 环境配置示例
# 复制为 .env 后填入真实值,.env 永远不进 git

# ====== 应用 ======
APP_NAME=michelle
APP_ENV=dev
LOG_LEVEL=INFO
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# ====== 数据 ======
DATABASE_URL=sqlite+aiosqlite:///./data/michelle.db
ARTIFACTS_DIR=./artifacts

# ====== LLM 主通道 (Claude Max 订阅,无 API key) ======
CLAUDE_CLI_PATH=claude
CLAUDE_TIMEOUT_SECONDS=180

# ====== LLM 备通道 (MiniMax) ======
# 撞 Claude rate-limit 时自动 fallback。
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1/text/chatcompletion_v2
MINIMAX_MODEL_TEXT=MiniMax-Text-01
MINIMAX_MODEL_REASONING=MiniMax-M2.7

# ====== LLM 升级通道 (Flywheel,配额恢复后) ======
FLYWHEEL_TOKEN=
FLYWHEEL_BASE_URL=https://flywheel.zstack.io/v1/chat/completions
FLYWHEEL_MODEL_PREMIUM=anthropic/claude-opus-4.7

# ====== 可观测性 ======
LOGFIRE_TOKEN=
LOGFIRE_PROJECT=michelle
OTEL_SERVICE_NAME=michelle-backend

# ====== 默认测试目标(Day 2 验证用)======
DEFAULT_TARGET_URL=http://172.25.17.105:5000/
DEFAULT_TARGET_USERNAME=admin
DEFAULT_TARGET_PASSWORD=password
