# Michelle 环境配置示例
# 复制为 .env 后填入真实值,.env 永远不进 git

# ====== 应用 ======
APP_NAME=michelle
APP_ENV=dev
LOG_LEVEL=INFO
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# ====== 数据 ======
DATABASE_URL=sqlite+aiosqlite:///./data/michelle.db
ARTIFACTS_DIR=./artifacts

# ====== LLM Gateway 多通道 ======
# Priority order (lower = higher priority): claude > codex > flywheel >
# deepseek > qwen > glm > kimi > gemini > minimax > relay.
# Empty key/token = disabled. Set only what you have.

# --- Subscription CLIs (free if you have the subscription) ---
CLAUDE_CLI_PATH=claude
CLAUDE_TIMEOUT_SECONDS=180
CODEX_CLI_PATH=codex
CODEX_ENABLED=false   # flip to true if `codex` is installed and logged in

# --- Premium proxy (Flywheel - GPT-5.5 / Claude Opus / multi-model) ---
FLYWHEEL_TOKEN=
FLYWHEEL_BASE_URL=          # e.g. https://your-proxy.example.com/v1/chat/completions
FLYWHEEL_MODEL_PREMIUM=claude-opus-4-7

# --- DeepSeek ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# --- Qwen / DashScope (Alibaba) ---
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_MODEL=qwen3-max

# --- GLM / 智谱 ---
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
GLM_MODEL=glm-4.7

# --- Kimi / Moonshot ---
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1/chat/completions
KIMI_MODEL=kimi-k2-0905-preview

# --- Gemini (OpenAI-compatible endpoint) ---
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
GEMINI_MODEL=gemini-2.5-pro

# --- MiniMax (native non-OpenAI protocol; supports vision) ---
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1/text/chatcompletion_v2
MINIMAX_MODEL_TEXT=MiniMax-Text-01
MINIMAX_MODEL_REASONING=MiniMax-M2.7

# --- Generic relay (OneAPI / NewAPI / OpenRouter / any OpenAI-compatible) ---
RELAY_API_KEY=
RELAY_BASE_URL=
RELAY_MODEL=
RELAY_NAME=relay

# ====== 可观测性 ======
LOGFIRE_TOKEN=
LOGFIRE_PROJECT=michelle
OTEL_SERVICE_NAME=michelle-backend

# ====== 默认测试目标(Day 2 验证用)======
DEFAULT_TARGET_URL=http://172.25.17.105:5000/
DEFAULT_TARGET_USERNAME=admin
DEFAULT_TARGET_PASSWORD=password
