# Michelle 环境配置示例
# 复制为 .env 后填入真实值,.env 永远不进 git

# ====== 应用 ======
APP_NAME=michelle
APP_ENV=dev
LOG_LEVEL=INFO
LOG_FILE=./logs/michelle.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_TOKEN=              # optional break-glass token; configure in shared/staging/prod
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=  # optional bootstrap password; empty => generate artifacts/bootstrap-admin.txt

# ====== 数据 ======
# Default storage is PostgreSQL for internal pilot use. Start a local Postgres
# or point this URL at your shared DB.
DATABASE_URL=postgresql+asyncpg://michelle:michelle@127.0.0.1:5432/michelle
# Local single-user fallback only:
# DATABASE_URL=sqlite+aiosqlite:///./data/michelle.db
ARTIFACTS_DIR=./artifacts

# ====== LLM Providers ======
# Michelle currently supports only claude-cli and codex-cli.

# --- Subscription CLIs (free if you have the subscription) ---
CLAUDE_CLI_PATH=claude
CLAUDE_TIMEOUT_SECONDS=180
CODEX_CLI_PATH=codex
CODEX_ENABLED=false   # flip to true if `codex` is installed and logged in
CODEX_TIMEOUT_SECONDS=180
CODEX_MODEL=gpt-5.5
CODEX_REASONING_EFFORT=low

# --- Optional Claude CLI routing ---
# Leave these empty to use the user's normal Claude subscription login.
# Set them only if your team intentionally routes Claude CLI through an
# Anthropic-compatible gateway.
ANTHROPIC_BASE_URL=           # e.g. http://127.0.0.1:4000
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=              # e.g. claude-opus-4-7
CLAUDE_CODE_ATTRIBUTION_HEADER=

# ====== 可观测性 ======
LOGFIRE_TOKEN=
LOGFIRE_PROJECT=michelle
OTEL_SERVICE_NAME=michelle-backend

# ====== 执行器 ======
# Hidden legacy override. Normal routing is configured from the UI via
# Generate cases / Execute cases / Diagnose failures.
EXECUTOR_LOOP=auto           # auto | generic_openai | claude_cli
GENERIC_AGENT_MAX_TURNS=30
PLAYWRIGHT_MCP_PACKAGE=@playwright/mcp@0.0.40
PLAYWRIGHT_MCP_CACHE_DIR=       # empty => ./artifacts/.npm-cache shared across runs
PLAYWRIGHT_MCP_NPM_REGISTRY=    # e.g. https://registry.npmmirror.com in restricted networks
PLAYWRIGHT_MCP_STARTUP_TIMEOUT_SECONDS=180

# ====== Dev Context / 企业开发上下文 ======
# Optional. Configure these when Michelle should import PRDs from a local
# zstack-workspace or fetch GitLab files through zstack-dev-mcp.
#
# Keep these paths outside the Michelle repository. Do not vendor
# zstack-workspace or zstack-dev-mcp into this repo.
MICHELLE_WORKSPACE_ROOT=        # e.g. /Users/yy/code/zstack-workspace
MICHELLE_ZDEV_MCP_COMMAND=node
MICHELLE_ZDEV_MCP_ARGS=         # e.g. /Users/yy/code/zstack-workspace/zstack-dev-mcp/dist/index.js
MICHELLE_ZDEV_MCP_CWD=          # e.g. /Users/yy/code/zstack-workspace/zstack-dev-mcp
MICHELLE_ZDEV_MCP_TIMEOUT_SECONDS=60
MICHELLE_DEV_CONTEXT_REPOS=zstack,zstack-ui-next,premium
MICHELLE_DEV_CONTEXT_MAX_FILES=8
MICHELLE_DEV_CONTEXT_MAX_MATCHES_PER_FILE=3
# Optional controlled SSH log collection. JSON format:
# {"servers":[{"name":"staging-api","host":"10.0.0.1","user":"readonly","env":"staging","roles":["api"],"log_paths":["/var/log/app.log"]}]}
MICHELLE_SERVER_LOGS_JSON=

# ====== 默认测试目标(Day 2 验证用)======
DEFAULT_TARGET_URL=http://localhost:5000/
DEFAULT_TARGET_USERNAME=admin
DEFAULT_TARGET_PASSWORD=password

# ====== 临时邮箱（注册主流程验证码）======
# mail_tm uses https://api.mail.tm to create disposable inboxes for E2E
# registration flows. Set TEMP_EMAIL_PROVIDER=none to disable.
TEMP_EMAIL_PROVIDER=mail_tm
TEMP_EMAIL_BASE_URL=https://api.mail.tm
TEMP_EMAIL_CODE_TIMEOUT_SECONDS=120
TEMP_EMAIL_POLL_INTERVAL_SECONDS=5
